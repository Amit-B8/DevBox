# Copy to .env for Compose. Never commit .env. These are placeholders, not production credentials.
POSTGRES_USER=devbox
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=devbox
# Direct host API use only: set to an explicitly chosen LOCAL database.
# Compose supplies its own internal URL using the POSTGRES_* values above.
DATABASE_URL=
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_LOCAL_WRITES=false
ENABLE_PUBLIC_WRITES=false
ENABLE_USAGE=false
ENABLE_FEEDBACK=false
# Server-only secret, minimum 32 characters; set only after configuring an enforcing gateway.
WRITE_PROXY_SECRET=
ALLOW_DATABASE_MIGRATIONS=false
ALLOW_RETENTION_DELETE=false
# Public build-time flags. Rebuild the frontend after changing these.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_USAGE_ENABLED=false
NEXT_PUBLIC_FEEDBACK_ENABLED=false
